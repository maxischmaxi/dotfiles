# Tuya-Cloud-Credentials aus deinem Projekt auf platform.tuya.com
# (Cloud → Development → dein Projekt → "Overview")
# Datei nach `.env` kopieren und ausfüllen. NICHT committen.
# https://platform.tuya.com/cloud/basic?id=p1782234571513judwa8&region=EU&toptab=application&authorizeTab=0

TUYA_API_KEY=hier_client_id_einfuegen
TUYA_API_SECRET=hier_client_secret_einfuegen
# Datacenter deines Projekts: eu (Central Europe), eu-w (Western Europe),
# us, us-e, cn, in, sg
TUYA_API_REGION=eu
